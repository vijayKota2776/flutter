rules_version = '2';

// Craft rules based on data in your Firestore database
// Allow public read for uploaded images & PDFs
service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================================
    // 1. DEVELOPMENT / TEST MODE (Open Access)
    // =========================================================================
    // match /{allPaths=**} {
    //   allow read, write: if true;
    // }

    // =========================================================================
    // 2. PRODUCTION RULES (Folder Specific & Content Validation)
    // =========================================================================

    // Flower Images rules
    match /flowers/images/{allPaths=**} {
      // Anyone can read/download images
      allow read: if true;
      // Allow write if file is an image and under 10MB
      allow write: if request.resource == null // for delete
                   || (request.resource.size < 10 * 1024 * 1024
                       && request.resource.contentType.matches('image/.*'));
    }

    // Flower PDF Documents rules
    match /flowers/pdfs/{allPaths=**} {
      // Anyone can read/download PDFs
      allow read: if true;
      // Allow write if file is a PDF and under 25MB
      allow write: if request.resource == null // for delete
                   || (request.resource.size < 25 * 1024 * 1024
                       && request.resource.contentType == 'application/pdf');
    }
  }
}
